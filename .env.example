# Backend environment (Cloud Run). Copy to .env, fill in, NEVER commit .env.
# Deploy: `gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-aishani-fitinerary < .env`, then run the deploy workflow.
# The frontend (Vercel) needs only VITE_API_BASE; see frontend/.env.example.

# --- LLM via OpenRouter (optional: leave OPENROUTER_API_KEY empty to run in sample mode, no model calls) ---
API_KEY=
# Any apiyi model id. Default deepseek-v4-1-flash-260910 (the AI Lodge default since 2026-11-08).
# The prompts and the safety log were tuned on claude-haiku-4-5-20251001; re-run the gold-set / red-team scripts after a switch.
MODEL_NAME=deepseek-v4-1-flash-260910

# --- CORS: exact frontend origin(s), comma separated. "*" is refused at startup. Unset = localhost dev origins only. ---
CORS_ORIGINS=https://your-app.vercel.app

# --- Shared AI Lodge rate limiter (Upstash Redis). Unset = AI quota disabled (fine for local dev). ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per-IP fallbacks per LLM action (the central control sheet overrides these at runtime). Default 5 each.
RATE_LIMIT_PARSE_MAX=5
RATE_LIMIT_REPAIR_MAX=5
RATE_LIMIT_PROFILE_MAX=5
RATE_LIMIT_REPLAN_MAX=5
RATE_LIMIT_COPILOT_MAX=5
# Explanations inside /optimise, /compare-hotels, /replan: over the limit, the built-in template explanation is used instead.
RATE_LIMIT_EXPLAIN_MAX=10
# Rolling window in seconds (default 432000 = 5 days)
RATE_LIMIT_WINDOW_SECONDS=432000

# --- Solver and flood protection (all optional, safe defaults shown) ---
# Active CPU-heavy solves per instance; a busy instance answers 423 solver_busy (503 is reserved for the kill switch) and the UI offers a retry.
SOLVER_CONCURRENCY=1
OPTIMISE_TIME_LIMIT_SECONDS=10
# Cloud Run's front end appends the client IP to X-Forwarded-For: 1 trusted hop.
TRUSTED_PROXY_HOPS=1
# Per-IP per-minute flood guard (in memory, per instance): expensive (AI routes) / standard (solver) / cheap (data, health)
RATE_LIMIT_EXPENSIVE_PER_MIN=6
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_CHEAP_PER_MIN=120
# Per-instance circuit breaker: model calls per rolling 24 h (backstop; the OpenRouter credit limit is the real one)
LLM_DAILY_CALL_CAP=300
REQUEST_DEADLINE_SECONDS=25
BODY_MAX_BYTES=65536
MAX_INPUT_CHARS=2000
# 1 = serve /docs and /openapi.json (development only)
ENABLE_DOCS=0
